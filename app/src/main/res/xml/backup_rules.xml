<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-Backup rules. With no <include> tags, the default rule includes the
  whole app data directory; the excludes below carve out the heavy stuff:
  installed JREs, downloaded server jars, and per-server worlds. These are
  multi-hundred-MB and re-downloadable on a fresh device, so backing them
  up would waste user storage and Drive quota.
-->
<full-backup-content>
    <exclude domain="file" path="runtimes/" />
    <exclude domain="file" path="servers/" />
    <exclude domain="file" path="downloads/" />
</full-backup-content>
