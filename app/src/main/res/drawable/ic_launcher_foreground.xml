<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: stylized first-person blocky arm holding a torch.
     108×108 viewport, all important content inside the 72×72 safe zone (x/y 18..90).
     Sleeve extends below the safe zone (intentional — suggests arm continuing). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- =========================================================== -->
    <!--   TORCH (drawn before the fist so the fist visually grips it) -->
    <!-- =========================================================== -->

    <!-- Outer flame: warm orange teardrop -->
    <path
        android:fillColor="#FFFF7A1C"
        android:pathData="M54,18
                          C70,26 70,40 54,46
                          C38,40 38,26 54,18 Z" />

    <!-- Mid flame: lantern yellow -->
    <path
        android:fillColor="#FFFFC44A"
        android:pathData="M54,24
                          C64,29 64,40 54,43
                          C44,40 44,29 54,24 Z" />

    <!-- Hot core: pale highlight -->
    <path
        android:fillColor="#FFFFF2C0"
        android:pathData="M54,30
                          C59,32 59,38 54,40
                          C49,38 49,32 54,30 Z" />

    <!-- Torch shaft (wood) -->
    <path
        android:fillColor="#FFB07A4A"
        android:pathData="M48,42 L60,42 L60,72 L48,72 Z" />
    <!-- Wood shadow / right side -->
    <path
        android:fillColor="#FF7A4F2A"
        android:pathData="M55,42 L60,42 L60,72 L55,72 Z" />
    <!-- Wood top cap (slightly darker, where flame burns) -->
    <path
        android:fillColor="#FF5C3815"
        android:pathData="M48,42 L60,42 L60,46 L48,46 Z" />
    <!-- Wood band detail mid-shaft -->
    <path
        android:fillColor="#FF7A4F2A"
        android:pathData="M48,56 L60,56 L60,58 L48,58 Z" />

    <!-- =========================================================== -->
    <!--   FIST (covers lower portion of torch shaft)                  -->
    <!-- =========================================================== -->

    <!-- Fist block (skin) -->
    <path
        android:fillColor="#FFE6B98A"
        android:pathData="M38,55 L70,55 L70,80 L38,80 Z" />
    <!-- Fist shadow on right -->
    <path
        android:fillColor="#FFB07F58"
        android:pathData="M62,55 L70,55 L70,80 L62,80 Z" />
    <!-- Knuckle ridges (top edge highlights) -->
    <path
        android:fillColor="#FFF2D0A8"
        android:pathData="M40,55 L46,55 L46,57 L40,57 Z
                          M48,55 L54,55 L54,57 L48,57 Z
                          M56,55 L62,55 L62,57 L56,57 Z" />
    <!-- Finger separations (vertical darker lines) -->
    <path
        android:fillColor="#FFB07F58"
        android:pathData="M46,55 L48,55 L48,80 L46,80 Z
                          M54,55 L56,55 L56,80 L54,80 Z" />

    <!-- =========================================================== -->
    <!--   WRIST + SLEEVE                                              -->
    <!-- =========================================================== -->

    <!-- Wrist skin -->
    <path
        android:fillColor="#FFE6B98A"
        android:pathData="M40,80 L68,80 L68,84 L40,84 Z" />
    <!-- Sleeve trim (darker top edge of sleeve) -->
    <path
        android:fillColor="#FF8E3A0F"
        android:pathData="M38,84 L70,84 L70,88 L38,88 Z" />
    <!-- Sleeve body (lantern-orange) -->
    <path
        android:fillColor="#FFD96B2C"
        android:pathData="M40,88 L68,88 L68,108 L40,108 Z" />
    <!-- Sleeve shadow (right side) -->
    <path
        android:fillColor="#FF8E3A0F"
        android:pathData="M62,88 L68,88 L68,108 L62,108 Z" />

</vector>
