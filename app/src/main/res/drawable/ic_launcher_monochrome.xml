<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon (monochrome) layer for Android 13+. Single solid color (white),
     the system tints it from the user's wallpaper-derived color. We keep the
     silhouette simpler than the full foreground so it reads at small sizes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="?attr/colorControlNormal">

    <!-- Flame -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,18
                          C70,26 70,40 54,46
                          C38,40 38,26 54,18 Z" />

    <!-- Torch shaft -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,42 L60,42 L60,72 L48,72 Z" />

    <!-- Fist block -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M38,55 L70,55 L70,80 L38,80 Z" />

    <!-- Wrist + sleeve -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,80 L68,80 L68,108 L40,108 Z" />

</vector>
